# Copie para .env somente para executar Docker Compose.
# .env não é carregado automaticamente por manage.py fora do Compose.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
WEB_PORT=8000
PORTAL_BASE_URL=http://127.0.0.1:8000

POSTGRES_USER=portal
POSTGRES_DB=service_desk
# Use senha URL-safe. Compose monta DATABASE_URL a partir destas variáveis.
POSTGRES_PASSWORD=replace-local-database-password
# Referências para execução fora do Compose (exportar explicitamente).
DATABASE_URL=postgresql://portal:replace-local-database-password@db:5432/service_desk
REDIS_URL=redis://redis:6379/0

# Produção: HTTPS obrigatório; somente habilitar confiança após proteger o proxy.
TRUST_PROXY_HEADERS=false
SECURE_HSTS_SECONDS=0

# Active Directory: mantenha desabilitado até homologar CA, bases e grupos.
LDAP_ENABLED=false
LOCAL_AUTH_ENABLED=true
# Keep false until the CA, bind account and role groups have been approved.
LDAP_APPROVED=false
AUTH_LDAP_SERVER_URI=ldaps://dc.example.invalid:636
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=
AUTH_LDAP_GROUP_SEARCH_BASE=
AUTH_LDAP_START_TLS=false
LDAP_CA_CERT_PATH=
LDAP_GROUP_COLABORADOR_DN=
LDAP_GROUP_TECNICO_TI_DN=
LDAP_GROUP_SUPERVISOR_TI_DN=
LDAP_GROUP_ADMIN_PORTAL_DN=

PLANNER_ENABLED=false
PLANNER_SYNC_ENABLED=false
MICROSOFT_GRAPH_APPROVED=false
GRAPH_TENANT_ID=
GRAPH_PLAN_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_AUTH_STRATEGY=client_credentials
# Delegated Planner authorization-code flow. Keep false until the authorized
# service account, redirect URI and approval for the isolated environment exist.
GRAPH_DELEGATED_OAUTH_ENABLED=false
PLANNER_TEST_ENABLED=false
# Anexos SharePoint: manter false até consentimento e revisão de ACL da TI.
PLANNER_ATTACHMENTS_ENABLED=false
GRAPH_ATTACHMENTS_STORAGE_APPROVED=false
GRAPH_ATTACHMENT_SCOPE_ENABLED=false
GRAPH_ATTACHMENTS_DRIVE_ID=
GRAPH_ATTACHMENTS_FOLDER_ID=
# Host exato aprovado, sem https://, sem path. Não presumir pelo tenant ID.
GRAPH_ATTACHMENTS_HOST=
# A Fernet key held only in the secret manager; generate with Fernet.generate_key().
GRAPH_TOKEN_ENCRYPTION_KEY=
PLANNER_BUCKET_ENTRADA_ID=
PLANNER_BUCKET_CONCLUIDO_ID=
PLANNER_BUCKET_EM_ANDAMENTO_ID=
PLANNER_SYNC_MIN_INTERVAL=15

EMAIL_ENABLED=false
NOTIFICATIONS_PROVIDER=console
GRAPH_MAILBOX_ID=
NOTIFICATIONS_TI_RECIPIENTS=
DEFAULT_FROM_EMAIL=nao-responda@example.invalid
